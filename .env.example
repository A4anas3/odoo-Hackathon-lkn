# =============================================================================
# Brightloop ERP - Environment Configuration Template
# =============================================================================

# Server Port
PORT=8080

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Option 1: Local Docker PostgreSQL 17 (Default)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/brightloop?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=brightloop_user
SPRING_DATASOURCE_PASSWORD=brightloop_password

# Option 2: Cloud Supabase PostgreSQL URI (Uncomment and replace with your project)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require&stringtype=unspecified
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<YOUR_SUPABASE_PASSWORD>

# -----------------------------------------------------------------------------
# Security & JWT Configuration
# -----------------------------------------------------------------------------
JWT_SECRET=BrightloopErpEnterpriseSecretKeyMustBeAtLeast512BitsLongForHS512SecurityCompliance2026
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# SMTP Notification / Outbox Gateway (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=mock@brightloop.local
SMTP_PASSWORD=mockpassword

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
